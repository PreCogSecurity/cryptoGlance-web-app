# Copy to .env (never commit .env) and adjust for your deployment.

# MobileMiner reporting key. Leave empty to disable reporting even if the
# feature is enabled in Settings.
MOBILEMINER_API_KEY=

# 1 = show PHP errors in the browser. Development only.
CG_DEBUG=0

# 1 = skip TLS certificate verification for outbound HTTP calls and the
# self-updater. Only for a trusted local mirror with a self-signed cert.
CG_INSECURE_TLS=0

# Timeout (seconds) for outbound HTTP requests.
CG_HTTP_TIMEOUT=20
