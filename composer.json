{
    "name": "cryptoglance/cryptoglance-web-app",
    "description": "cryptoGlance - self-hosted cryptocurrency mining dashboard",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sockets": "*",
        "michelf/php-markdown": "^1.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "classmap": [
            "includes/classes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "CryptoGlance\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --testdox",
        "lint": "phpcs"
    }
}
